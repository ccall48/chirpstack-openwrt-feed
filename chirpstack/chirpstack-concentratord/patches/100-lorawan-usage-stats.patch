+use super::{airtime, events};
 
 static STATS: LazyLock<Mutex<chirpstack_api::gw::GatewayStats>> =
     LazyLock::new(|| Mutex::new(Default::default()));
 
+static USAGE: LazyLock<Mutex<Usage>> = LazyLock::new(|| Mutex::new(Usage::new(Instant::now())));
+
+const ACTIVE_DEVICES_1H: Duration = Duration::from_secs(60 * 60);
+const ACTIVE_DEVICES_24H: Duration = Duration::from_secs(24 * 60 * 60);
+
+// Upper bound on the number of tracked DevAddrs, to bound memory usage on
+// gateways that receive a very large number of (foreign) devices.
+const ACTIVE_DEVICES_MAX: usize = 100_000;
+
+/// Airtime and active device tracking. Unlike the GatewayStats counters,
+/// the totals and the device list are not reset on every stats interval.
+struct Usage {
+    rx_airtime_total: Duration,
+    tx_airtime_total: Duration,
+    rx_airtime_interval: Duration,
+    tx_airtime_interval: Duration,
+    interval_start: Instant,
+    devices: HashMap<u32, Instant>,
+}
+
+impl Usage {
+    fn new(now: Instant) -> Self {
+        Usage {
+            rx_airtime_total: Duration::ZERO,
+            tx_airtime_total: Duration::ZERO,
+            rx_airtime_interval: Duration::ZERO,
+            tx_airtime_interval: Duration::ZERO,
+            interval_start: now,
+            devices: HashMap::new(),
+        }
+    }
+
+    fn add_rx(&mut self, pl: &chirpstack_api::gw::UplinkFrame, now: Instant) {
+        if let Some(toa) = airtime::uplink_time_on_air(
+            pl.tx_info.as_ref().and_then(|v| v.modulation.as_ref()),
+            pl.phy_payload.len(),
+        ) {
+            self.rx_airtime_interval += toa;
+            self.rx_airtime_total += toa;
+        }
+
+        if let Some(dev_addr) = airtime::uplink_dev_addr(&pl.phy_payload) {
+            if self.devices.len() < ACTIVE_DEVICES_MAX || self.devices.contains_key(&dev_addr) {
+                self.devices.insert(dev_addr, now);
+            }
+        }
+    }
+
+    fn add_tx(&mut self, toa: Duration) {
+        self.tx_airtime_interval += toa;
+        self.tx_airtime_total += toa;
+    }
+
+    /// Adds the usage metrics to the given metadata and resets the interval
+    /// counters.
+    fn report_and_reset(&mut self, metadata: &mut HashMap<String, String>, now: Instant) {
+        self.devices
+            .retain(|_, last_seen| now.duration_since(*last_seen) < ACTIVE_DEVICES_24H);
+
+        let active_1h = self
+            .devices
+            .values()
+            .filter(|last_seen| now.duration_since(**last_seen) < ACTIVE_DEVICES_1H)
+            .count();
+
+        let elapsed = now.duration_since(self.interval_start);
+        let pct = |d: Duration| {
+            if elapsed.is_zero() {
+                0.0
+            } else {
+                d.as_secs_f64() / elapsed.as_secs_f64() * 100.0
+            }
+        };
+
+        metadata.insert("active_devices_1h".into(), active_1h.to_string());
+        metadata.insert("active_devices_24h".into(), self.devices.len().to_string());
+        metadata.insert(
+            "rx_airtime_ms_total".into(),
+            self.rx_airtime_total.as_millis().to_string(),
+        );
+        metadata.insert(
+            "tx_airtime_ms_total".into(),
+            self.tx_airtime_total.as_millis().to_string(),
+        );
+        metadata.insert(
+            "rx_airtime_pct".into(),
+            format!("{:.2}", pct(self.rx_airtime_interval)),
+        );
+        metadata.insert(
+            "tx_airtime_pct".into(),
+            format!("{:.2}", pct(self.tx_airtime_interval)),
+        );
+
+        self.rx_airtime_interval = Duration::ZERO;
+        self.tx_airtime_interval = Duration::ZERO;
+        self.interval_start = now;
+    }
+}
+
