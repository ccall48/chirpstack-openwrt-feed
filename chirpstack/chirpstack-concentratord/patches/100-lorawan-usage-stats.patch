+        u.add_rx(&uplink(1), start);
+        u.add_rx(&uplink(1), start);
+        u.add_rx(&uplink(2), start + Duration::from_secs(2 * 60 * 60));
+        u.add_tx(Duration::from_millis(300));
+
+        let now = start + Duration::from_secs(2 * 60 * 60) + Duration::from_secs(30);
+        let mut md = HashMap::new();
+        u.report_and_reset(&mut md, now);
+
+        assert_eq!("1", md["active_devices_1h"]);
+        assert_eq!("2", md["active_devices_24h"]);
+        assert_eq!("139", md["rx_airtime_ms_total"]);
+        assert_eq!("300", md["tx_airtime_ms_total"]);
+        // 300 ms / 7230 s
+        assert_eq!("0.00", md["tx_airtime_pct"]);
+
+        // Second interval of 10 s, interval counters must be reset.
+        u.add_tx(Duration::from_millis(500));
+        let now = now + Duration::from_secs(10);
+        let mut md = HashMap::new();
+        u.report_and_reset(&mut md, now);
+
+        assert_eq!("0.00", md["rx_airtime_pct"]);
+        assert_eq!("5.00", md["tx_airtime_pct"]);
+        assert_eq!("800", md["tx_airtime_ms_total"]);
+
+        // Devices expire after 24h.
+        let now = start + Duration::from_secs(24 * 60 * 60) + Duration::from_secs(1);
+        let mut md = HashMap::new();
+        u.report_and_reset(&mut md, now);
+        assert_eq!("0", md["active_devices_1h"]);
+        assert_eq!("1", md["active_devices_24h"]);
+    }
+}
