index 0000000..2b5e837
--- /dev/null
+++ b/libconcentratord/src/airtime.rs
@@ -0,0 +1,335 @@
+//! Time-on-air calculation for received (uplink) frames.
+//!
+//! Downlink time-on-air is provided by the HAL (lgw_time_on_air), but the HAL
+//! does not expose this for received packets. The formulas below are ported
+//! from the Semtech HALs so that uplink and downlink airtime are computed in
+//! the same way:
+//!
+//! * LoRa (sub-GHz): sx1302_hal, loragw_aux.c `lora_packet_time_on_air` with
+//!   the low data-rate optimization rule from the SX127x / SX126x datasheets
+//!   (enabled when the symbol time >= 16 ms).
+//! * LoRa (2.4 GHz): gateway_2g4_hal, loragw_hal.c `lgw_time_on_air`.
+//! * FSK: sx1302_hal, loragw_hal.c `lgw_time_on_air`.
+use std::time::Duration;
+
+use chirpstack_api::gw;
+
+// LoRaWAN uplinks always use an explicit header and a payload CRC.
+const UPLINK_CRC: bool = true;
+const UPLINK_HEADER: bool = true;
+
+// Default LoRaWAN preamble length (symbols).
+const LORA_PREAMBLE: u32 = 8;
+
+// FSK defaults (bytes) as used by the Semtech HAL.
+const FSK_PREAMBLE: u32 = 5;
+const FSK_SYNC_WORD: u32 = 3;
+
+// 2.4 GHz LoRa bandwidths as reported by the 2g4 HAL wrapper.
+const BW_2G4: [u32; 4] = [203000, 406000, 812000, 1625000];
+
+/// Returns the time-on-air of an uplink frame with the given modulation and
+/// PHYPayload size (bytes), or None if it can not be calculated.
+pub fn uplink_time_on_air(modulation: Option<&gw::Modulation>, size: usize) -> Option<Duration> {
+    match modulation?.parameters.as_ref()? {
+        gw::modulation::Parameters::Lora(v) => {
+            let preamble = if v.preamble > 0 {
+                v.preamble
+            } else {
+                default_preamble(v.spreading_factor)
+            };
+
+            if BW_2G4.contains(&v.bandwidth) {
+                lora_2g4_time_on_air(
+                    v.bandwidth,
+                    v.spreading_factor,
+                    v.code_rate(),
+                    preamble,
+                    size,
+                )
+            } else {
+                lora_time_on_air(
+                    v.bandwidth,
+                    v.spreading_factor,
+                    v.code_rate(),
+                    preamble,
+                    size,
+                )
+            }
+        }
+        gw::modulation::Parameters::Fsk(v) => fsk_time_on_air(v.datarate, size),
+        // LR-FHSS uplinks are not published by Concentratord.
+        gw::modulation::Parameters::LrFhss(_) => None,
+    }
+}
+
+fn default_preamble(sf: u32) -> u32 {
+    match sf {
+        5 | 6 => 12,
+        _ => LORA_PREAMBLE,
+    }
+}
+
+fn lora_time_on_air(
+    bw: u32,
+    sf: u32,
+    cr: gw::CodeRate,
+    preamble: u32,
+    size: usize,
+) -> Option<Duration> {
+    if bw == 0 || !(5..=12).contains(&sf) {
+        return None;
+    }
+
+    let cr: f64 = match cr {
+        gw::CodeRate::Cr45 | gw::CodeRate::CrUndefined => 1.0,
+        gw::CodeRate::Cr46 => 2.0,
+        gw::CodeRate::Cr47 => 3.0,
+        gw::CodeRate::Cr48 => 4.0,
+        _ => return None,
+    };
+
+    let sf_f = sf as f64;
+    let t_sym = (1u64 << sf) as f64 / bw as f64; // seconds
+
+    let h = if UPLINK_HEADER { 1.0 } else { 0.0 };
+    let crc = if UPLINK_CRC { 16.0 } else { 0.0 };
+    let de = if t_sym >= 0.016 { 1.0 } else { 0.0 };
+    let sf_ge_7 = sf >= 7;
+
+    let n_payload =
+        ((8.0 * size as f64 + crc - 4.0 * sf_f + if sf_ge_7 { 8.0 } else { 0.0 } + 20.0 * h)
+            .max(0.0)
+            / (4.0 * (sf_f - 2.0 * de)))
+            .ceil()
+            * (cr + 4.0);
+
+    let n_symbols = preamble as f64 + if sf_ge_7 { 4.25 } else { 6.25 } + 8.0 + n_payload;
+
+    Some(Duration::from_secs_f64(n_symbols * t_sym))
+}
+
+fn lora_2g4_time_on_air(
+    bw: u32,
+    sf: u32,
+    cr: gw::CodeRate,
+    preamble: u32,
+    size: usize,
+) -> Option<Duration> {
+    if !(5..=12).contains(&sf) {
+        return None;
+    }
+
+    // HAL coderate values: 1..4 = 4/5..4/8, 5..7 = LI 4/5, LI 4/6, LI 4/8.
+    let cr: u32 = match cr {
+        gw::CodeRate::Cr45 | gw::CodeRate::CrUndefined => 1,
+        gw::CodeRate::Cr46 => 2,
+        gw::CodeRate::Cr47 => 3,
+        gw::CodeRate::Cr48 => 4,
+        gw::CodeRate::CrLi45 => 5,
+        gw::CodeRate::CrLi46 => 6,
+        gw::CodeRate::CrLi48 => 7,
+        _ => return None,
+    };
+
+    let fine_synch = sf <= 6;
+    let long_interleaving = cr > 4;
+
+    // The HAL uses the bandwidth in kHz (rounded).
+    let bw_khz = match bw {
+        203000 => 203.0,
+        406000 => 406.0,
+        812000 => 812.0,
+        1625000 => 1625.0,
+        _ => return None,
+    };
+
+    let sym_period_ms = (1u64 << sf) as f64 / bw_khz;
+    let fec_rate = if long_interleaving {
+        4.0 / (cr + if cr == 7 { 1 } else { 0 }) as f64
+    } else {
+        4.0 / (4 + cr) as f64
+    };
+
+    let total_bytes = size as f64 + if UPLINK_CRC { 2.0 } else { 0.0 };
+    let bits_symbol = sf as f64 - if sf >= 11 { 2.0 } else { 0.0 };
+    let n_sym_header = if UPLINK_HEADER { 20.0 } else { 0.0 };
+    let mut infobits_header =
+        sf as f64 * 4.0 + if fine_synch { 8.0 } else { 0.0 } - 8.0 - n_sym_header;
+
+    let n_sym_data = if !long_interleaving {
+        let infobits_payload = (8.0 * total_bytes - infobits_header).max(0.0);
+        8.0 + (infobits_payload / 4.0 / bits_symbol).ceil() * (cr + 4) as f64
+    } else if UPLINK_HEADER {
+        if infobits_header < 8.0 * total_bytes {
+            infobits_header = infobits_header.min(8.0 * size as f64);
+        }
+        let infobits_payload = (8.0 * total_bytes - infobits_header).max(0.0);
+        8.0 + (infobits_payload / fec_rate / bits_symbol).ceil()
+    } else {
+        let bits_symbol_start = sf as f64 - 2.0 + if fine_synch { 2.0 } else { 0.0 };
+        let n_sym_start = (8.0 * total_bytes / fec_rate / bits_symbol_start).ceil();
+        if n_sym_start < 8.0 {
+            n_sym_start
+        } else {
+            let codedbits_header = bits_symbol_start * 8.0;
+            let codedbits_payload = 8.0 * total_bytes / fec_rate - codedbits_header;
+            8.0 + (codedbits_payload / bits_symbol).ceil()
+        }
+    };
+
+    let n_sym_preamble = preamble as f64 + 4.25 + if fine_synch { 2.0 } else { 0.0 };
+
+    Some(Duration::from_secs_f64(
+        (n_sym_preamble + n_sym_data) * sym_period_ms / 1000.0,
+    ))
+}
+
+fn fsk_time_on_air(datarate: u32, size: usize) -> Option<Duration> {
+    if datarate == 0 {
+        return None;
+    }
+
+    let crc = if UPLINK_CRC { 2 } else { 0 };
+    let bytes = FSK_PREAMBLE + FSK_SYNC_WORD + 1 + size as u32 + crc;
+
+    Some(Duration::from_secs_f64(
+        8.0 * bytes as f64 / datarate as f64,
+    ))
+}
+
+/// Returns the DevAddr of a LoRaWAN (R1) data uplink, or None if the
+/// PHYPayload is not a data uplink.
+pub fn uplink_dev_addr(phy_payload: &[u8]) -> Option<u32> {
+    // MHDR (1) + FHDR (min 7) + MIC (4)
+    if phy_payload.len() < 12 {
+        return None;
+    }
+
+    let mhdr = phy_payload[0];
+    let m_type = mhdr >> 5;
+    let major = mhdr & 0x03;
+
+    // 0b010 = UnconfirmedDataUp, 0b100 = ConfirmedDataUp
+    if major != 0 || (m_type != 0b010 && m_type != 0b100) {
+        return None;
+    }
+
+    Some(u32::from_le_bytes([
+        phy_payload[1],
+        phy_payload[2],
+        phy_payload[3],
+        phy_payload[4],
+    ]))
+}
+
+#[cfg(test)]
+mod test {
+    use super::*;
+
+    fn lora(bw: u32, sf: u32, cr: gw::CodeRate) -> gw::Modulation {
+        gw::Modulation {
+            parameters: Some(gw::modulation::Parameters::Lora(gw::LoraModulationInfo {
+                bandwidth: bw,
+                spreading_factor: sf,
+                code_rate: cr.into(),
+                ..Default::default()
+            })),
+        }
+    }
+
+    fn toa_ms(m: &gw::Modulation, size: usize) -> f64 {
+        uplink_time_on_air(Some(m), size).unwrap().as_secs_f64() * 1000.0
+    }
+
+    #[test]
+    fn test_lora_time_on_air() {
+        // Reference values: Semtech LoRa calculator (explicit header, CRC on,
+        // 8 symbol preamble, CR 4/5).
+        let tests = [
+            (125000, 7, 13, 46.336),
+            (125000, 7, 51, 102.656),
+            (125000, 9, 13, 164.864),
+            (125000, 10, 13, 288.768),
+            (125000, 11, 13, 577.536),
+            (125000, 12, 13, 1155.072),
+            (125000, 12, 51, 2465.792),
+            (500000, 8, 13, 20.608),
+            // Low data-rate optimization also applies to SF12 / 250 kHz.
+            (250000, 12, 13, 577.536),
+        ];
+
+        for (bw, sf, size, expected) in tests {
+            let m = lora(bw, sf, gw::CodeRate::Cr45);
+            let toa = toa_ms(&m, size);
+            assert!(
+                (toa - expected).abs() < 0.01,
+                "bw: {}, sf: {}, size: {}, expected: {}, got: {}",
+                bw,
+                sf,
+                size,
+                expected,
+                toa
+            );
+        }
+    }
+
+    #[test]
+    fn test_lora_2g4_time_on_air() {
+        // SF12, BW 812 kHz, CR 4/5, 8 symbol preamble, 13 bytes.
+        // Header bits: 12*4 - 8 - 20 = 20, payload bits: 15*8 - 20 = 100,
+        // data symbols: 8 + ceil(100 / 4 / 10) * 5 = 23, preamble: 12.25.
+        let m = lora(812000, 12, gw::CodeRate::Cr45);
+        let expected = (12.25 + 23.0) * 4096.0 / 812.0;
+        assert!((toa_ms(&m, 13) - expected).abs() < 0.001);
+    }
+
+    #[test]
+    fn test_fsk_time_on_air() {
+        let m = gw::Modulation {
+            parameters: Some(gw::modulation::Parameters::Fsk(gw::FskModulationInfo {
+                datarate: 50000,
+                ..Default::default()
+            })),
+        };
+        // (5 + 3 + 1 + 13 + 2) * 8 / 50000 = 3.84 ms
+        assert!((toa_ms(&m, 13) - 3.84).abs() < 0.001);
+    }
+
+    #[test]
+    fn test_no_modulation() {
+        assert!(uplink_time_on_air(None, 13).is_none());
+        assert!(uplink_time_on_air(Some(&gw::Modulation { parameters: None }), 13).is_none());
+    }
+
+    #[test]
+    fn test_uplink_dev_addr() {
+        // UnconfirmedDataUp, DevAddr 01020304 (LE on the wire).
+        let mut b = vec![0x40, 0x04, 0x03, 0x02, 0x01, 0x00, 0x00, 0x00];
+        b.extend_from_slice(&[0x00; 4]);
+        assert_eq!(Some(0x01020304), uplink_dev_addr(&b));
+
+        // ConfirmedDataUp.
+        b[0] = 0x80;
+        assert_eq!(Some(0x01020304), uplink_dev_addr(&b));
+
+        // JoinRequest.
+        b[0] = 0x00;
+        assert_eq!(None, uplink_dev_addr(&b));
+
+        // UnconfirmedDataDown.
+        b[0] = 0x60;
+        assert_eq!(None, uplink_dev_addr(&b));
+
+        // Proprietary (e.g. Gateway Mesh).
+        b[0] = 0xe0;
+        assert_eq!(None, uplink_dev_addr(&b));
+
+        // Non LoRaWAN R1 major.
+        b[0] = 0x41;
+        assert_eq!(None, uplink_dev_addr(&b));
+
+        // Too short.
+        assert_eq!(None, uplink_dev_addr(&[0x40, 0x04, 0x03, 0x02, 0x01]));
+    }
+}
